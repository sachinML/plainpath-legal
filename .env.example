# Copy to .env for local runs. Never commit real keys.
# Streamlit Community Cloud: set the same names under App settings → Secrets.

# auto | gemini | groq | openai | ollama | mock
LLM_PROVIDER=auto

# Google AI Studio (Gemini) — recommended free-tier path
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Any OpenAI-compatible chat completions endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

LLM_TIMEOUT_SECONDS=45
